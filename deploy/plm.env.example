# Environment for the cPanel Python App screen (Setup Python App -> Environment variables).
# Add each line below as one NAME / VALUE pair. Replace USER with your cPanel username and
# plm.example.com with the domain the application answers on.
#
# Profile: sign-in required, accounts created by the administrator, the visitor form compulsory.

# --- where the data lives (outside public_html, never served by Apache) -------------------
PLM_DATA_DIR=/home/USER/plm_data
PLM_WEB_DIST=/home/USER/plm/web/dist

# --- accounts ------------------------------------------------------------------------------
PLM_AUTH_ENABLED=1
# 1 only until you have registered yourself as the first (admin) account, then set it to 0
PLM_OPEN_REGISTRATION=1
PLM_SESSION_HOURS=72
PLM_LOCK_MINUTES=15
# leave PLM_SECRET_KEY unset: one is generated into PLM_DATA_DIR/.secret_key on first start and
# kept there. Set it explicitly only if you ever run two servers against the same database.

# --- guest sandbox (try before signing up) ---------------------------------------------------
PLM_GUEST_ENABLED=1
PLM_GUEST_MAX_POINTS=5000
PLM_GUEST_MAX_PROJECTS=2
PLM_GUEST_MAX_TIN_RUNS=3
PLM_GUEST_TTL_DAYS=7

# --- visitor register (who is using the server, and what they did) ---------------------------
PLM_VISITOR_TRACKING=1
PLM_VISITOR_INTAKE=1
# compulsory: no project, no design and no export until name, email, phone and designation are given
PLM_VISITOR_INTAKE_REQUIRED=1
PLM_VISITOR_INTAKE_REPEAT_DAYS=7
PLM_VISITOR_COOKIE_DAYS=365
# Apache sits in front of Passenger, so the real address arrives in X-Forwarded-For
PLM_TRUST_PROXY=1

# --- load, jobs and limits --------------------------------------------------------------------
# "worker": the web process only queues heavy work; the cron job below executes it. This is what
# shared hosting needs, because Passenger recycles the request process.
PLM_JOB_MODE=worker
PLM_SYNC_POINT_LIMIT=150000
PLM_MAX_HEAVY=2
PLM_BUSY_QUEUE=3
PLM_MAX_UPLOAD_MB=200
PLM_TIN_CACHE=2

# --- browser -----------------------------------------------------------------------------------
# the front end is served from the same host, so same-origin: no wildcard
PLM_CORS_ORIGINS=https://plm.example.com
