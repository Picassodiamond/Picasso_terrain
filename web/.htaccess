# Apache rules when the built front end (web/dist) is served by Apache from public_html and the API
# runs as a cPanel Python App mounted at /api. Copy this file into the folder that holds index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # let Passenger handle the API and docs
  RewriteRule ^api/ - [L]
  # static assets exist as files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # everything else is the single-page app
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|wasm|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType application/wasm .wasm
